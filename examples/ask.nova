# v0.7 (ADR-008): ASK reads one line of real, synchronous input per call.
# Run this one directly to try it interactively:
#   node src/cli.js run examples/ask.nova
# Or piped (this is also how test/run-examples.js verifies it, matching
# the original chat's own "printf ... | nova run ..." verification):
#   printf "Ada\n7\n" | node src/cli.js run examples/ask.nova

SET name = ASK "What is your name? "
SHOW "Hello, {name}!"

SET favorite = ASK "Pick a number: "
SHOW UPPER("you picked {favorite}")
