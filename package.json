{
  "name": "nova-lang",
  "version": "0.14.0",
  "description": "NOVA - a unified, natural-reading programming language. Core language, lists/records, typed procedures, DATA named types, persistence, a stdlib, ASK input, TRY/CATCH, a PAGE compiler (static/data-bound/interactive HTML), and SERVICE/API (a live HTTP server).",
  "type": "module",
  "main": "./src/nova.js",
  "exports": {
    ".": "./src/nova.js"
  },
  "bin": {
    "nova": "./src/cli.js"
  },
  "files": [
    "src/",
    "examples/",
    "docs/",
    "README.md",
    "HANDOFF.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.js",
    "run": "node src/cli.js run",
    "examples": "node test/run-examples.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nova",
    "nova-lang",
    "programming-language",
    "interpreter",
    "compiler",
    "cli",
    "dsl"
  ],
  "author": "Sharif_tech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sharifwa123/nova-lang.git"
  },
  "homepage": "https://github.com/Sharifwa123/nova-lang#readme",
  "bugs": {
    "url": "https://github.com/Sharifwa123/nova-lang/issues"
  }
}
