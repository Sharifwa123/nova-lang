{
  "name": "sharif-tech-nova-lang",
  "displayName": "NOVA Language by Sharif Technologies",
  "description": "Syntax highlighting, and Run/Build/Serve commands, for Sharif NOVA - the programming language developed by Sharif Technologies.",
  "version": "0.4.0",
  "publisher": "sharif-tech",
  "private": true,
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sharifwa123/nova-lang.git",
    "directory": "editors/vscode/nova-lang"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["nova", "nova-lang"],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nova"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nova",
        "aliases": ["NOVA", "nova"],
        "extensions": [".nova"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nova",
        "scopeName": "source.nova",
        "path": "./syntaxes/nova.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "nova-icons",
        "label": "NOVA Icons",
        "path": "./icons/nova-icon-theme.json"
      }
    ],
    "commands": [
      { "command": "nova.run", "title": "NOVA: Run File", "icon": "$(play)" },
      { "command": "nova.build", "title": "NOVA: Build (compile PAGE to HTML)", "icon": "$(package)" },
      { "command": "nova.serve", "title": "NOVA: Serve (start live HTTP server)", "icon": "$(server-environment)" },
      { "command": "nova.stopServe", "title": "NOVA: Stop Server", "icon": "$(debug-stop)" },
      { "command": "nova.addIconToMaterialTheme", "title": "NOVA: Add NOVA Icon to Material Icon Theme" }
    ],
    "menus": {
      "editor/title": [
        { "command": "nova.run", "when": "resourceLangId == nova", "group": "navigation@1" },
        { "command": "nova.build", "when": "resourceLangId == nova", "group": "navigation@2" },
        { "command": "nova.serve", "when": "resourceLangId == nova", "group": "navigation@3" }
      ],
      "editor/context": [
        { "command": "nova.run", "when": "resourceLangId == nova", "group": "nova@1" },
        { "command": "nova.build", "when": "resourceLangId == nova", "group": "nova@2" },
        { "command": "nova.serve", "when": "resourceLangId == nova", "group": "nova@3" },
        { "command": "nova.stopServe", "when": "resourceLangId == nova", "group": "nova@4" }
      ],
      "explorer/context": [
        { "command": "nova.run", "when": "resourceLangId == nova", "group": "nova@1" },
        { "command": "nova.build", "when": "resourceLangId == nova", "group": "nova@2" },
        { "command": "nova.serve", "when": "resourceLangId == nova", "group": "nova@3" },
        { "command": "nova.stopServe", "when": "resourceLangId == nova", "group": "nova@4" }
      ]
    },
    "keybindings": [
      {
        "command": "nova.run",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "resourceLangId == nova"
      }
    ],
    "configuration": {
      "title": "NOVA",
      "properties": {
        "nova.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to NOVA's `src/cli.js`. Leave empty to auto-detect: first by walking up from the current file for a folder containing `src/cli.js` (a NOVA checkout), then by falling back to the globally-installed `nova` command (`npm install -g nova-lang`)."
        },
        "nova.defaultServePort": {
          "type": "number",
          "default": 3000,
          "description": "Default port used by \"NOVA: Serve\" when no port is configured per-run."
        },
        "nova.openBrowserOnServe": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open your default browser once \"NOVA: Serve\" is actually answering requests (not on a guessed delay - it's polled)."
        }
      }
    }
  }
}
