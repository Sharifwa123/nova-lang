{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(IF\\b|FOR\\s+EACH\\b|REPEAT\\b|DO\\b|DATA\\b|TRY\\b|PAGE\\b|SERVICE\\b|API\\s+(GET|POST)\\b|BUTTON\\b|WHEN\\s+CLICKED\\b)",
      "end": "^\\s*END\\b"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
